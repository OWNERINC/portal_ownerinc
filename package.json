{
  "name": "ownerinc-portal",
  "private": true,
  "scripts": {
    "bootstrap": "npm --prefix api ci && npm --prefix cron ci && npm --prefix cms ci",
    "db:migrate": "node api/db/migrate.js",
    "db:provision": "node api/db/provision.js",
    "admin:bootstrap": "node api/db/bootstrap-admin.js",
    "doctor": "node scripts/doctor.mjs",
    "lint": "node scripts/verify.mjs syntax",
    "security": "npm audit --prefix api --omit=dev --omit=optional --audit-level=high && npm audit --prefix cron --omit=dev --omit=optional --audit-level=high && npm audit --prefix cms --omit=dev --audit-level=high",
    "sbom": "node scripts/sbom.mjs",
    "solides:probe": "node scripts/solides-probe.mjs",
    "build:public": "node scripts/generate-public-shell.mjs",
    "test": "node scripts/verify.mjs tests",
    "typecheck:cms": "node cms/node_modules/typescript/bin/tsc --project cms/tsconfig.json --noEmit --incremental false",
    "test:cms": "node cms/scripts/test.mjs",
    "test:payload": "node scripts/test-payload-integration.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
