{
  "name": "ownerinc-portal",
  "private": true,
  "scripts": {
    "bootstrap": "npm --prefix api ci && npm --prefix cron ci",
    "db:migrate": "node api/db/migrate.js",
    "db:provision": "node api/db/provision.js",
    "admin:bootstrap": "node api/db/bootstrap-admin.js",
    "doctor": "node scripts/doctor.mjs",
    "lint": "node scripts/verify.mjs syntax",
    "security": "npm audit --prefix api --omit=dev --omit=optional --audit-level=high && npm audit --prefix cron --omit=dev --omit=optional --audit-level=high",
    "sbom": "node scripts/sbom.mjs",
    "solides:probe": "node scripts/solides-probe.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
