# Dockerfile-specific root-context allowlist. Root .dockerignore excludes scripts;
# do not relax that shared file or COPY the repository/private workspace wholesale.
**
!cms/
!cms/package.json
!cms/package-lock.json
!cms/next.config.mjs
!cms/tsconfig.json
!cms/next-env.d.ts
!cms/src/
!cms/src/**
!cms/scripts/
!cms/scripts/provision-db.ts
!cms/scripts/check-runtime-packaging.mjs
!cms/scripts/import-owner-news.ts
!cms/scripts/control-news.ts
!api/
!api/package.json
!api/package-lock.json
!api/cms/
!api/cms/blocks.js
!api/cms/locks.js
!api/cms/permissions.js
!api/owner-news/
!api/owner-news/editorial.js
!api/owner-news/home.js
!api/owner-news/authority.js
!api/middleware/
!api/middleware/policy.js
!scripts/
!scripts/import-owner-news.mjs
!scripts/owner-news-payload/
!scripts/owner-news-payload/bundle.mjs
!scripts/owner-news-payload/contract.mjs
!scripts/owner-news-payload/files.mjs
!scripts/owner-news-payload/legacy-converter.mjs
!scripts/owner-news-payload/export.mjs
!scripts/owner-news-payload/cutover.mjs
# Defense in depth for private/derived files even if accidentally under src.
**/.env
**/.env.*
**/env.json
**/state.json
**/compose.env
**/*.pem
**/*.key
**/*.log
**/node_modules
**/.next
**/uploads
**/.owner-news-import
**/.git
**/.superpowers
**/*.tsbuildinfo
