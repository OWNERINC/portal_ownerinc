+  assert.equal(h.node('historyEmpty').classList.contains('hidden'), true);
+  assert.equal(h.node('status').textContent, 'Mensagem do editor.');
+  assert.equal(h.node('mediaStatus').textContent, 'Falha da foto anterior.');
