+  await h.followCmsLink();
+  assert.equal(h.requests.filter(call => call.options.method === 'DELETE').length, 2);
+  h.latest(`/api/cms/assets/${TEMP_PDF}`).resolve({ deleted: true }); await drain();
+  assertCmsNavigation(h);
+});
