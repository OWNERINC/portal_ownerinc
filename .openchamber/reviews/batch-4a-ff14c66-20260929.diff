diff --git a/api/admin-list-filters.js b/api/admin-list-filters.js
new file mode 100644
index 0000000..6646724
--- /dev/null
+++ b/api/admin-list-filters.js
@@ -0,0 +1,15 @@
+// These helpers receive list-query strings, not SQL identifiers or fragments.
+function literalSubstring(value) {
+  return `%${value.trim().replace(/[\\%_]/g, '\\$&')}%`;
+}
+
+function civilDate(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const [year, month, day] = value.split('-').map(Number);
+  if (year < 1 || year > 9999 || month < 1 || month > 12) return false;
+  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
+  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+  return day >= 1 && day <= days[month - 1];
+}
+
+module.exports = { civilDate, literalSubstring };
