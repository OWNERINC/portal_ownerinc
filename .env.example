# =====================================================
# PostgreSQL
# =====================================================
POSTGRES_DB=portal
POSTGRES_USER=portal_admin
POSTGRES_PASSWORD=SENHA_ADMIN_FORTE_AQUI
PORTAL_API_DB_PASSWORD=SENHA_API_FORTE_AQUI
PORTAL_CRON_DB_PASSWORD=SENHA_CRON_FORTE_AQUI
MIGRATION_DATABASE_URL=postgresql://portal_admin:SENHA_ADMIN_FORTE_AQUI@postgres:5432/portal
API_DATABASE_URL=postgresql://portal_api:SENHA_API_FORTE_AQUI@postgres:5432/portal
CRON_DATABASE_URL=postgresql://portal_cron:SENHA_CRON_FORTE_AQUI@postgres:5432/portal

# Publicação local do Nginx. Mantenha loopback quando houver proxy reverso.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
COMPOSE_PROJECT_NAME=ownerinc-portal
IMAGE_REGISTRY=ghcr.io/gabrielgarciaberwads-source
NODE_ENV=production
TZ=America/Sao_Paulo
NOTIFICATION_RETENTION_DAYS=730
OMBUDSMAN_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1825

# Origens adicionais são opcionais; mesmo domínio já é permitido pela API.
CORS_ORIGINS=

# =====================================================
# Firebase Admin SDK — Service Account
# Gere em: Firebase Console > Configurações > Contas de Serviço
# =====================================================
FIREBASE_PROJECT_ID=portal-ownerinc
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@portal-ownerinc.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
# Somente desenvolvimento local com Firebase Auth Emulator:
# FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9099

# =====================================================
# SendGrid — Envio de e-mails
# =====================================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=portal@ownerinc.com.br

# =====================================================
# Sólides DP/Ponto — desligada até homologação
# off | internal | pilot | general | manager | write
# =====================================================
SOLIDES_RELEASE_STAGE=off
SOLIDES_TOKEN=
SOLIDES_EMPLOYER_BASE_URL=https://employer.tangerino.com.br/
SOLIDES_PUNCH_BASE_URL=https://apis.tangerino.com.br/punch/
SOLIDES_REPORT_BASE_URL=
SOLIDES_REQUEST_TIMEOUT_MS=12000
# UIDs Firebase separados por vírgula; usados somente no estágio pilot.
SOLIDES_PILOT_UIDS=
# Somente para `npm run solides:probe`; nunca use CPF/PIS como identificador.
SOLIDES_TEST_EMPLOYEE_ID=

# =====================================================
# WhatsApp via Z-API (desativado por padrão)
# =====================================================
# ZAPI_TOKEN=seu_token_zapi
# ZAPI_INSTANCE=sua_instancia_zapi
